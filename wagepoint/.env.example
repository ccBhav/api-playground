# Issued by Wagepoint (sent separately). Server-side only: never commit, log or expose the secret.
WAGEPOINT_CLIENT_ID=
WAGEPOINT_CLIENT_SECRET=

# Optional: OAuth scope, space-separated (default: services, as in Wagepoint's quick start)
WAGEPOINT_SCOPE=

# Optional: preselect a company instead of picking one in the app (the `id` from /v1/companies)
WAGEPOINT_COMPANY_ID=

# Optional: only if Wagepoint gives you different (e.g. sandbox) endpoints.
# Defaults: https://payroll.wagepoint.com/prod/identity/connect/token and https://api.wagepoint.com
WAGEPOINT_TOKEN_URL=
WAGEPOINT_API_BASE_URL=

# Local port for the example app (default 8080)
PORT=
