# From https://developer.myob.com/dashboard
MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=
# Must match the redirect URI registered with MYOB. MYOB accepts http://127.0.0.1:8080 in the
# dashboard but its consent page then fails with "Something went wrong" on Connect, so in practice
# use an https ngrok domain (see NGROK_DOMAIN and `npm run start:ngrok`).
MYOB_REDIRECT_URI=http://localhost:8080

# Optional: scopes to request, space-separated (default: all). MYOB's consent page says
# "Something went wrong" if any of them isn't enabled for your app.
MYOB_SCOPES=

# Optional: only if the company file asks for its own login (sent as x-myobapi-cftoken)
MYOB_CF_USERNAME=
MYOB_CF_PASSWORD=

# Optional, for `npm run start:ngrok`: your static ngrok domain (e.g. something.ngrok-free.app).
# Register https://<NGROK_DOMAIN> as a redirect URI in the MYOB dashboard.
NGROK_DOMAIN=
# Local port the runner's callback server listens on (default 8080)
PORT=
